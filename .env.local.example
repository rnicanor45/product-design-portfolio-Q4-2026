# Copy this file to .env.local (which is gitignored) and fill in real values.
# Never commit .env.local.

# Secret used to sign the site-wide "unlocked" cookie. Any long random string
# works. Generate one with:
#   openssl rand -base64 32
UNLOCK_SECRET=

# The single password that gates the entire site (see src/proxy.ts).
SITE_PASSWORD=
