# Copy this file to .env.local (which is gitignored) and fill in real values.
# Never commit .env.local.

# Secret used to sign the "unlocked" cookie for password-protected case
# studies. Any long random string works. Generate one with:
#   openssl rand -base64 32
UNLOCK_SECRET=

# One password env var per protected project, named
# PROJECT_PASSWORD_<SLUG_UPPERCASED_WITH_UNDERSCORES>.
# Add a new one automatically by setting `protected: true` on a project in
# src/data/projects.ts — the required env var name is derived from its slug.
PROJECT_PASSWORD_CONFIDENTIAL_PROJECT=
PROJECT_PASSWORD_PATIENT_PORTAL=
